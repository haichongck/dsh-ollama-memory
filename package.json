{
  "name": "@haichongck/dsh-ollama-memory",
  "version": "1.1.0",
  "description": "两层长期记忆插件：核心记忆文件（每轮注入系统提示）+ 本地向量库（Ollama 嵌入）。含结构化类别、存入去重、容量治理（超限归档）、作废取代、产物指纹过时检测与「相似度×时间衰减×类别权重」检索。",
  "license": "MIT",
  "author": "haichongck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haichongck/dsh-ollama-memory.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "ollama",
    "embeddings"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.1 <0.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}